# Local Postgres (matches docker-compose.yml). Point this at Supabase /
# managed Postgres connection string in production.
DATABASE_URL="postgresql://flexdesk:flexdesk@localhost:5432/flexdesk?schema=public"

# Signing secret for auth JWTs. Generate a real random value for production,
# e.g. `openssl rand -base64 48`.
JWT_SECRET="dev-only-secret-change-me"
JWT_EXPIRES_IN="12h"

PORT=4000
NODE_ENV=development

# Comma-separated list of origins allowed to call this API.
CORS_ORIGIN="http://localhost:5173"

# Minutes after a booking's slot start before an unconfirmed reservation is
# auto-released by the release runner.
CHECKIN_GRACE_MINUTES=120

# Cron expression the auto-release runner uses (default: every 5 minutes).
RELEASE_RUNNER_CRON="*/5 * * * *"
